{
  "compilerOptions": {
    "target": "ES2022",
    "ignoreDeprecations": "6.0",
    "module": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "tests",
    "vitest.config.ts"
  ]
}
